<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.26.xsd">

    <changeSet author="Vitaly Belotserkovskii" id="create-callback-table">
        <preConditions onFail="MARK_RAN" onError="CONTINUE">
            <not>
                <tableExists tableName="callback_table"/>
            </not>
        </preConditions>

        <createTable schemaName="public"
                     tableName="callback_table"
                     remarks="Таблица для хранения обратных вызовов">

            <column name="id" type="UUID" remarks="Идентификатор">
                <constraints nullable="false"
                             primaryKey="true"
                             primaryKeyName="callback_table_pk"
                />
            </column>

            <column name="correlation_id" type="VARCHAR(36)" remarks="Корреляционный идентификатор">
                <constraints nullable="false"/>
            </column>

            <column name="callback_type" type="VARCHAR(255)" remarks="Тип обратного вызова"/>

            <column name="callback_json" type="TEXT" remarks="Сущность обратного вызова"/>

            <column name="timestamp" type="BIGINT" remarks="Временная метка"/>

        </createTable>

        <createIndex indexName="correlation_id_idx" tableName="callback_table">
            <column name="correlation_id"/>
        </createIndex>

    </changeSet>
</databaseChangeLog>